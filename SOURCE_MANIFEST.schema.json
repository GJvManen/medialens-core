{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MediaLens Source Manifest",
  "type": "object",
  "required": [
    "sources"
  ],
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "url",
          "country"
        ]
      }
    }
  }
}